# ============================================================
# Veeam Monitor - Environment Configuration
# Sao chép file này thành .env và điền thông tin thực tế
# ============================================================

# --- Veeam Backup & Replication Server ---
VEEAM_HOST=https://192.168.1.10:9419
VEEAM_USER=Administrator
VEEAM_PASS=YourVeeamPassword

# --- InfluxDB ---
INFLUX_USERNAME=admin
INFLUX_PASSWORD=Admin@123456
INFLUX_ORG=veeam-org
INFLUX_BUCKET=veeam
INFLUX_TOKEN=veeam-super-secret-token-change-me

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=Admin@123456
GRAFANA_DOMAIN=localhost

# --- Collector ---
# Tần suất thu thập data (giây). Mặc định 300s = 5 phút
COLLECT_INTERVAL=300
